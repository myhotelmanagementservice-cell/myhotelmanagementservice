<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1a1a2e">
<link rel="manifest" href="/manifest.json">
<title>Inaya — Hotel OS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Naskh+Arabic:wght@400;600;700&family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<link rel="stylesheet" href="style.css">
</head>
<body>
<!-- ===== SESSION LOADER - Fixes Login Flash ===== -->
<div id="sessionLoader">
<div class="spinner"></div>
<p>Loading your session...</p>
</div>
<div id="sockStatus"><span class="sock-dot connecting" id="sockDot"></span><span id="sockTxt">Connecting…</span></div>
<div id="toolbar">
<div class="toolbar-row">
<button class="tb-btn active" onclick="setLang('en')" id="lb-en">🇬 EN</button>
<button class="tb-btn" onclick="setLang('hi')" id="lb-hi">🇮 हि</button>
<button class="tb-btn" onclick="setLang('ar')" id="lb-ar">🇸🇦 ع</button>
<button class="tb-btn" onclick="toggleOnlineMode()" id="onlineBtn" title="Toggle Online/Offline">🟢 Online</button>
<button class="tb-btn" onclick="toggleContrast()" title="Toggle High Contrast">🔆</button>
</div>
<div class="toolbar-row">
<button class="tb-btn" onclick="adjustFont(-1)" title="Decrease Font">A-</button>
<button class="tb-btn" onclick="adjustFont(0)" title="Reset Font">A</button>
<button class="tb-btn" onclick="adjustFont(1)" title="Increase Font">A+</button>
<button class="tb-btn" onclick="toggleDark()" id="darkBtn">🌙</button>
<button class="tb-btn" onclick="toggleThemeDD()" title="Theme">🎨</button>
</div>
<div class="toolbar-row">
<span style="display:flex;align-items:center;gap:3px;background:rgba(255,255,255,.15);padding:3px 7px;border-radius:8px"><span style="font-size:9px">☀</span><input type="range" class="tb-slider" id="brightSlider" min=".5" max="1.5" step=".05" value="1" oninput="setBrightness(this.value)"></span>
<button class="tb-btn" onclick="reqNotif()" id="notifBtn">🔔</button>
<button class="tb-btn" onclick="haptic()">📳</button>
<button class="tb-btn" onclick="speakWelcome()" title="Voice Welcome">🔊</button>
</div>
<div class="toolbar-row">
<button class="tb-btn" onclick="tbRefreshAll()" title="Refresh All Data">🔄</button>
<button class="tb-btn" onclick="tbFullscreen()" id="fsBtn" title="Fullscreen">⛶</button>
<button class="tb-btn" onclick="tbToggleSound()" id="soundBtn" title="Toggle Sound">🔊</button>
<button class="tb-btn" onclick="tbCycleCurrency()" id="currBtn" title="Quick Currency">🌍</button>
<button class="tb-btn" onclick="tbLockScreen()" title="Lock Screen">🔒</button>
</div>
<div class="toolbar-row">
<button class="tb-btn" onclick="tbPing()" id="pingBtn" title="Check Server">📡</button>
<button class="tb-btn" onclick="tbPrint()" title="Print">🖨️</button>
<button class="tb-btn" onclick="tbClearCache()" title="Clear Cache">🗑️</button>
<button class="tb-btn" onclick="tbWorldClock()" title="World Clock">🕐</button>
<button class="tb-btn" onclick="tbHelp()" title="Help">❓</button>
</div>
</div>
<div id="themeDD">
<div style="font-size:10px;font-weight:700;margin-bottom:6px;color:var(--fg)" data-i18n="selectTheme">🎨 Theme</div>
<div style="display:flex;flex-wrap:wrap;gap:4px;justify-content:center;max-width:200px">
<div class="th-dot active" data-theme="default" style="background:linear-gradient(135deg,#6c63ff,#a78bfa)" onclick="setTheme('default')" title="Default 💜"></div>
<div class="th-dot" data-theme="sunset" style="background:linear-gradient(135deg,#f59e0b,#ef4444)" onclick="setTheme('sunset')" title="Sunset 🌅"></div>
<div class="th-dot" data-theme="forest" style="background:linear-gradient(135deg,#10b981,#059669)" onclick="setTheme('forest')" title="Forest 🌿"></div>
<div class="th-dot" data-theme="ocean" style="background:linear-gradient(135deg,#06b6d4,#3b82f6)" onclick="setTheme('ocean')" title="Ocean 🌊"></div>
<div class="th-dot" data-theme="royal" style="background:linear-gradient(135deg,#ec4899,#8b5cf6)" onclick="setTheme('royal')" title="Royal 👑"></div>
<div class="th-dot" data-theme="midnight" style="background:linear-gradient(135deg,#1e3a8a,#1e40af)" onclick="setTheme('midnight')" title="Midnight 🌙"></div>
<div class="th-dot" data-theme="rose" style="background:linear-gradient(135deg,#be123c,#f43f5e)" onclick="setTheme('rose')" title="Rose 🌹"></div>
<div class="th-dot" data-theme="amber" style="background:linear-gradient(135deg,#b45309,#d97706)" onclick="setTheme('amber')" title="Amber 🍯"></div>
<div class="th-dot" data-theme="mint" style="background:linear-gradient(135deg,#0f766e,#0d9488)" onclick="setTheme('mint')" title="Mint 🌱"></div>
<div class="th-dot" data-theme="ruby" style="background:linear-gradient(135deg,#991b1b,#dc2626)" onclick="setTheme('ruby')" title="Ruby ♦️"></div>
<div class="th-dot" data-theme="lavender" style="background:linear-gradient(135deg,#5b21b6,#7c3aed)" onclick="setTheme('lavender')" title="Lavender 🔮"></div>
<div class="th-dot" data-theme="coral" style="background:linear-gradient(135deg,#c2410c,#ea580c)" onclick="setTheme('coral')" title="Coral 🪸"></div>
<div class="th-dot" data-theme="slate" style="background:linear-gradient(135deg,#334155,#475569)" onclick="setTheme('slate')" title="Slate 🩶"></div>
<div class="th-dot" data-theme="copper" style="background:linear-gradient(135deg,#92400e,#b45309)" onclick="setTheme('copper')" title="Copper 🥉"></div>
<div class="th-dot" data-theme="sakura" style="background:linear-gradient(135deg,#9d174d,#db2777)" onclick="setTheme('sakura')" title="Sakura 🌸"></div>
<div class="th-dot" data-theme="emerald" style="background:linear-gradient(135deg,#047857,#059669)" onclick="setTheme('emerald')" title="Emerald 💚"></div>
</div>
</div>
<div id="loginPage">
<div class="login-card">
<div id="loginNetBadge" class="online">🟢 Online</div>
<div id="toasts"></div>
<div class="login-logo">👑</div>
<div class="login-h" id="loginHotelName">Inaya Hotel</div>
<div class="login-sub" data-i18n="welcomeSubtitle">Complete Management System</div>
<div id="loginClock" class="login-clock"></div>
<div class="login-tabs">
<button class="login-tab active" id="guestTabBtn" onclick="switchLogin('guest')" data-i18n="guestTab">🏨 Guest</button>
<button class="login-tab" id="adminTabBtn" onclick="switchLogin('admin')" data-i18n="adminTab">👑 Admin</button>
</div>
<form id="guestLoginForm" onsubmit="guestLogin(event)">
<div class="form-row" style="margin-bottom:8px"><label class="lbl" data-i18n="hotelIdLbl">Hotel ID</label><input class="inp" id="guestHotelIdIn" type="text" placeholder="Enter Hotel ID" style="margin-bottom:0"></div>

<button type="button" onclick="startGoogleLogin()" id="googleLoginBtn" style="width:100%;margin:10px 0 4px;padding:11px 10px;background:#fff;border:1.5px solid #dadce0;border-radius:10px;cursor:pointer;font-size:14px;font-weight:600;color:#3c4043;display:flex;align-items:center;justify-content:center;gap:10px;font-family:inherit;transition:box-shadow .2s,border-color .2s" onmouseover="this.style.boxShadow='0 2px 10px rgba(0,0,0,.18)';this.style.borderColor='#4285F4'" onmouseout="this.style.boxShadow='none';this.style.borderColor='#dadce0'">
  <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.29-8.16 2.29-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
  <span data-i18n="loginWithGoogle">Continue with Google</span>
</button>
<p id="googleLoginHint" style="font-size:11px;color:#e53e3e;text-align:center;margin-bottom:6px;display:none" data-i18n="googleHint">⚠️ Hotel ID required above</p>

<div style="display:flex;align-items:center;gap:8px;margin:8px 0"><div style="flex:1;height:1px;background:rgba(0,0,0,.12)"></div><span style="font-size:11px;color:#aaa;white-space:nowrap" data-i18n="orText">OR login manually</span><div style="flex:1;height:1px;background:rgba(0,0,0,.12)"></div></div>

<div class="form-row" style="margin-bottom:8px"><label class="lbl" data-i18n="yourName">Your Name</label><input class="inp" id="guestNameIn" data-i18n-ph="enterName" placeholder="Enter your name" style="margin-bottom:0"></div>
<div class="form-row" style="margin-bottom:8px"><label class="lbl" data-i18n="roomNumber">Room Number</label><input class="inp" id="guestRoomIn" type="number" placeholder="e.g. 101" style="margin-bottom:0"></div>
<button class="btn-primary" style="width:100%;padding:11px;margin-top:4px" type="submit" data-i18n="loginGuest">🔐 Login as Guest</button>
</form>
<form id="adminLoginForm" class="hidden" onsubmit="adminLogin(event)">
<div class="form-row"><label class="lbl" data-i18n="hotelIdLbl">Hotel ID</label><input class="inp" id="adminHotelIdIn" type="text" data-i18n-ph="enterHotelId" placeholder="Enter Hotel ID" required></div>
<div class="form-row"><label class="lbl" data-i18n="emailAddress">Email</label><input class="inp" id="adminEmailIn" type="email" data-i18n-ph="adminLogin" placeholder="Administrator login" required></div>
<div class="form-row"><label class="lbl" data-i18n="password">Password</label><input class="inp" id="adminPassIn" type="password" data-i18n-ph="enterPassword" placeholder="Enter password" required></div>
<button class="btn-primary" style="width:100%;padding:11px" type="submit" data-i18n="loginAdmin">🔐 Login as Admin</button>
</form>
<div style="text-align:center;margin-top:10px;font-size:10px;opacity:.5" id="tenantLabel" hidden></div>
</div>
</div>
<div id="rolePage" class="hidden" style="min-height:100dvh;background:var(--header);display:flex;align-items:center;justify-content:center;padding:12px">
<div class="card" style="width:100%;max-width:520px">
<button onclick="backToLogin()" style="font-size:13px;color:var(--p1);background:none;border:none;cursor:pointer;margin-bottom:10px" data-i18n="back">← Back</button>
<h2 style="font-size:18px;font-weight:700;text-align:center;margin-bottom:14px;color:var(--fg)" data-i18n="selectRole">👑 Select Your Role</h2>
<div class="role-grid" id="roleGrid"></div>
</div>
</div>
<div id="adminDash" class="hidden">
<div class="header">
<h1>👑 <span id="aHotelName">Inaya</span> — <span id="aRole">Admin</span></h1>
<div class="header-right">
<a href="#" onclick="window.location.href='/subscribe.html?hotelId=' + HID" class="logout-btn" style="text-decoration:none;background:rgba(255,255,255,.3)">💳 Subscription</a>
<span class="clock-badge" id="aClock"></span>
<button class="logout-btn" style="position:relative;padding:4px 14px" onclick="showAdminTab('notifications')" title="Notifications">
  🔔
  <span id="notifBadge" style="display:none;position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;border-radius:50%;width:16px;height:16px;font-size:9px;font-weight:700;align-items:center;justify-content:center">0</span>
</button>
<button class="logout-btn" onclick="logout()" data-i18n="logout">Logout</button>
</div>
</div>
<div class="tabs-bar"><div class="tabs-bar-inner" id="adminTabsBar"></div></div>
<div class="page-wrap" id="adminTabsContent"></div>
</div>
<div id="guestDash" class="hidden">
<div class="header">
<h1>🏨 <span id="gHotelName">Inaya</span></h1>
<div class="header-right">
<span class="clock-badge" id="gClock"></span>
<span id="gInfo" class="clock-badge"></span>
<span id="gPts" class="clock-badge">⭐ 0 pts</span>
<button class="logout-btn" onclick="logout()" data-i18n="logout">Logout</button>
</div>
</div>
<div class="page-wrap">
<div class="stat-grid">
<div class="stat-card"><div class="stat-val" id="gTotReq">0</div><div class="stat-lbl" data-i18n="myRequests">Requests</div></div>
<div class="stat-card"><div class="stat-val" id="gPendReq" style="color:#f59e0b">0</div><div class="stat-lbl" data-i18n="pending">Pending</div></div>
<div class="stat-card"><div class="stat-val" id="gDoneReq" style="color:#10b981">0</div><div class="stat-lbl" data-i18n="completed">Done</div></div>
</div>
<div class="guest-nav" id="guestNav"></div>
<div id="guestPanes"></div>
</div>
</div>
<div id="modals"></div>
<script src="script.js"></script>
</body>
</html>
